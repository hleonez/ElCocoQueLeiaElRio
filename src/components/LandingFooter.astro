---
import type { LandingContent } from '../content/types';
import MotionControl from './MotionControl.astro';

interface Props {
  footer: LandingContent['footer'];
  controls: LandingContent['controls'];
}

const { footer, controls } = Astro.props;
---

{footer.enabled && (
  <footer id={footer.id} class="site-footer">
    <div class="container">
      <p class="farewell">{footer.farewell}</p>
      <p>{footer.credits}</p>
      {footer.rightsNotice && <p>{footer.rightsNotice}</p>}
      {footer.links.length > 0 && (
        <ul class="external-links">
          {footer.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}
        </ul>
      )}
      <MotionControl controls={controls} />
    </div>
  </footer>
)}
