---
import type { LandingContent } from '../content/types';
interface Props { controls: LandingContent['controls'] }
const { controls } = Astro.props;
---

<button class="motion-control" type="button" data-motion-control
  data-enable={controls.enableMotion} data-disable={controls.disableMotion}
  data-reduced={controls.reducedMotion} aria-pressed="false" hidden>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <path d="M3 7c3-4 6 4 9 0s6 4 9 0M3 12c3-4 6 4 9 0s6 4 9 0M3 17c3-4 6 4 9 0s6 4 9 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
  <span>{controls.disableMotion}</span>
</button>

<script>
  import { initMotionControls } from '../scripts/motion';
  initMotionControls();
</script>
