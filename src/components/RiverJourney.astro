---
import type { SectionIllustration } from '../content/types';

interface Props { illustration?: SectionIllustration }
const { illustration } = Astro.props;
---

<div class="river-journey">
  <!-- Escenografía de apoyo. La hoja acompaña el scroll; no representa a Drilo. -->
  <svg class="river-journey__map" viewBox="0 0 600 720" fill="none" aria-hidden="true" focusable="false">
    <path class="river-journey__shore" d="M218 44C500 100 498 220 300 260S44 418 250 450 510 590 330 676" />
    <path class="river-journey__water" d="M218 44C500 100 498 220 300 260S44 418 250 450 510 590 330 676" />
    <path class="river-journey__trail" pathLength="1" d="M218 44C500 100 498 220 300 260S44 418 250 450 510 590 330 676" />
    <g class="river-journey__plants" fill="currentColor">
      <path d="M104 206c-37-18-49-46-37-81 30 15 44 43 37 81Zm0 0c5-39 26-58 61-58-5 34-25 53-61 58ZM455 431c-32-28-37-57-17-88 25 24 31 53 17 88Zm0 0c12-33 34-47 65-40-12 30-34 43-65 40Z" />
    </g>
    <g class="river-journey__leaf">
      <path d="M-19 10C-22-12-7-24 21-20 25 2 10 19-19 10Z" fill="#a83f35" />
      <path d="m-16 9 31-24" stroke="#fff4c9" stroke-width="2" stroke-linecap="round" />
    </g>
  </svg>
  <div class="river-journey__art">
    {illustration
      ? <img src={illustration.src} alt={illustration.alt} width={illustration.width} height={illustration.height} loading="lazy" />
      : <p>Ilustración original de Drilo pendiente</p>}
  </div>
</div>
