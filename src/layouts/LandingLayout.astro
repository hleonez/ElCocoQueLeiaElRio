---
import type { LandingContent } from '../content/types';
import '../styles/landing.css';
import '../styles/motion.css';

interface Props {
  seo: LandingContent['seo'];
}

const { seo } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/opendyslexic/OpenDyslexic-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/opendyslexic/OpenDyslexic-Bold.woff2" as="font" type="font/woff2" crossorigin />
    {seo.noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={seo.description} />
    <title>{seo.title}</title>
  </head>
  <body>
    <div class="journey-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
